generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

generator zod {
  provider                  = "zod-prisma-types"
  createRelationValuesTypes = "true"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String          @id @default(cuid())
  email            String          @unique
  name             String?
  createdAt        DateTime        @default(now())
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  provider         String?
  providerId       String?         @unique
  updatedAt        DateTime        @updatedAt
  accounts         Account[]
  Authenticators   Authenticator[]
  createdExercises Exercise[]      @relation("UserCreatedExercises")
  heightLogs       HeightLog[]
  sessions         Session[]
  weightLogs       WeightLog[]
  workoutLogs      WorkoutLog[]
  workoutPlans     WorkoutPlan[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model HeightLog {
  id         String   @id @default(cuid())
  userId     String
  heightCm   Float
  recordedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model WeightLog {
  id         String   @id @default(cuid())
  userId     String
  weightKg   Float
  recordedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model WorkoutPlan {
  id           String        @id @default(cuid())
  userId       String
  name         String
  createdAt    DateTime      @default(now())
  muscleGroups MuscleGroup[]
  workoutDays  WorkoutDay[]
  user         User          @relation(fields: [userId], references: [id])
}

model WorkoutDay {
  id        String               @id @default(cuid())
  planId    String
  name      String               @default("Workout day")
  dayOfWeek Int
  plan      WorkoutPlan          @relation(fields: [planId], references: [id])
  exercises WorkoutDayExercise[]
}

model Exercise {
  id              String               @id @default(cuid())
  name            String               
  description     String?
  userDefined     Boolean              @default(false)
  createdById     String?
  muscleGroups    MuscleGroup[]
  createdBy       User?                @relation("UserCreatedExercises", fields: [createdById], references: [id])
  workoutDayLinks WorkoutDayExercise[]
  workoutLogs     WorkoutLog[]
}

model WorkoutDayExercise {
  id          String     @id @default(cuid())
  dayId       String
  exerciseId  String
  order       Int
  sets        Int
  reps        Int
  weights     Float      @default(7.5)
  restSeconds Int
  day         WorkoutDay @relation(fields: [dayId], references: [id])
  exercise    Exercise   @relation(fields: [exerciseId], references: [id])
}

model WorkoutLog {
  id            String   @id @default(cuid())
  userId        String
  exerciseId    String
  performedAt   DateTime @default(now())
  setsCompleted Int
  repsPerSet    Int[]
  weightPerSet  Float[]
  notes         String?
  exercise      Exercise @relation(fields: [exerciseId], references: [id])
  user          User     @relation(fields: [userId], references: [id])
}

enum MuscleGroup {
  CHEST
  BACK
  LEGS
  SHOULDERS
  BICEPS
  TRICEPS
  CORE
  GLUTES
  FULL_BODY
}
