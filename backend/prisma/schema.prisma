// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

generator zod {
  provider       = "zod-prisma-types"
  createRelationValuesTypes = true
}

enum MuscleGroup {
  CHEST
  BACK
  LEGS
  SHOULDERS
  BICEPS
  TRICEPS
  CORE
  GLUTES
  FULL_BODY
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  provider      String?
  providerId    String?         @unique
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Auth.js relations
  accounts      Account[]
  sessions      Session[]
  Authenticators Authenticator[]

  // App-specific relations
  heightLogs    HeightLog[]
  weightLogs    WeightLog[]
  workoutPlans  WorkoutPlan[]
  workoutLogs   WorkoutLog[]
  createdExercises Exercise[]  @relation("UserCreatedExercises")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model HeightLog {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  heightCm  Float
  recordedAt DateTime @default(now())
}

model WeightLog {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  weightKg  Float
  recordedAt DateTime @default(now())
}

model WorkoutPlan {
  id          String       @id @default(cuid())
  user        User         @relation(fields: [userId], references: [id])
  userId      String
  name        String
  createdAt   DateTime     @default(now())
  workoutDays WorkoutDay[]
  muscleGroups MuscleGroup[]
}

model WorkoutDay {
  id        String       @id @default(cuid())
  plan      WorkoutPlan  @relation(fields: [planId], references: [id])
  planId    String
  dayOfWeek Int          // 0 (Sunday) to 6 (Saturday)
  exercises WorkoutDayExercise[]
}

model Exercise {
  id              String                @id @default(cuid())
  name            String
  description     String?
  userDefined     Boolean               @default(false)
  createdBy       User?                 @relation("UserCreatedExercises", fields: [createdById], references: [id])
  createdById     String?
  workoutDayLinks WorkoutDayExercise[]
  workoutLogs     WorkoutLog[]
  muscleGroups    MuscleGroup[]
}

model WorkoutDayExercise {
  id          String      @id @default(cuid())
  day         WorkoutDay  @relation(fields: [dayId], references: [id])
  dayId       String
  exercise    Exercise    @relation(fields: [exerciseId], references: [id])
  exerciseId  String
  order       Int
  sets        Int
  reps        Int
  restSeconds Int
}

model WorkoutLog {
  id             String     @id @default(cuid())
  user           User       @relation(fields: [userId], references: [id])
  userId         String
  exercise       Exercise   @relation(fields: [exerciseId], references: [id])
  exerciseId     String
  performedAt    DateTime   @default(now())
  setsCompleted  Int
  repsPerSet     Int[]
  weightPerSet   Float[]
  notes          String?
}